# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
gow
gow.exe

# Allow the gow CLI source code (the binary is ignored above, but the source must be tracked)
!cmd/gow/
!cmd/gow/**

bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work
go.work.sum

# Dependency directories (optional, uncomment if vendoring)
# vendor/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Build and dist
dist/
build/

# Logs and temp
*.log
tmp/
temp/

# Local env / secrets
.env
.env.local
*.pem
*.key
*.crt

# The accidentally committed binary (explicit)
gow.exe

# Deprecated documentation (superseded by LARAVEL_LITE_1.2.md)
Current_Capabilities.md

# Analysis reports (generated, not for repo)
*_analysis.md
analyzed_bug_implementation_plan.md
BUG_FIX_SUMMARY.md

# Skeleton patches and updates (used for maintaining the separate gow-skeleton repo)
# These folders contain template code and are not part of the main Go module.
# They were causing import/build errors when running `go build ./...`
skeleton-patches/
skeleton-updates/

# Demo / starter project (separate git repo)
demo/

# =============================================================================
# Additional Common Ignores (Go + General Development)
# =============================================================================

# More environment / secrets
.env.*
.envrc
.direnv/

# Coverage reports
coverage/
*.cover
*.coverprofile
*.cover.out

# Cache directories
.cache/
**/.cache/

# Vendor directory (uncomment if you ever vendor dependencies)
# vendor/

# Release / packaging artifacts
*.tar.gz
*.tgz
*.zip
releases/
dist/

# Node / frontend (in case any frontend tooling is added later)
node_modules/

# Generated storage / cache (common in frameworks)
storage/cache/
storage/logs/
storage/framework/

# Backup and swap files
*.bak
*.backup
*.swp
*.swo

# Misc development files
*.orig
*.rej

# Go specific
/testbin/
*.test

